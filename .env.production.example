APP_NAME="WavePos"
APP_ENV=production
APP_KEY=base64:2Zo099X8sUSrZ0pCePa72gAje02rPqI1pFpgpedahWg=
APP_DEBUG=false
APP_URL=https://wavepos.vercel.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
