{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,automark-1.0.0/**,public/images/**,public/video/**,public/website/**,tests/**}"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/build/$1"
    },
    {
      "src": "/images/(.*)",
      "headers": {
        "cache-control": "public, max-age=86400"
      },
      "dest": "/public/images/$1"
    },
    {
      "src": "/video/(.*)",
      "dest": "/public/video/$1"
    },
    {
      "src": "/website/?",
      "dest": "/public/website/index.html"
    },
    {
      "src": "/website/(.*)",
      "dest": "/public/website/$1"
    },
    {
      "src": "/(favicon\\.ico|robots\\.txt)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "APP_KEY": "base64:2Zo099X8sUSrZ0pCePa72gAje02rPqI1pFpgpedahWg=",
    "SESSION_DRIVER": "cookie",
    "ARTISAN_KEY": "wv_sec_8d4f91b72e063a5c9d18e24fa7b30c1e",
    "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1",
    "APP_CONFIG_CACHE": "/tmp/bootstrap/cache/config.php",
    "APP_EVENTS_CACHE": "/tmp/bootstrap/cache/events.php",
    "APP_PACKAGES_CACHE": "/tmp/bootstrap/cache/packages.php",
    "APP_ROUTES_CACHE": "/tmp/bootstrap/cache/routes.php",
    "APP_SERVICES_CACHE": "/tmp/bootstrap/cache/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_STORE": "array",
    "LOG_CHANNEL": "stderr"
  }
}
